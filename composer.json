{
    "name": "holsterlabs/asset-bundle",
    "description": "On-demand CSS and JavaScript collection, bundling and resource publishing for Symfony",
    "type": "symfony-bundle",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": ">=8.2",
        "matthiasmullie/minify": "^1.3",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/filesystem": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/service-contracts": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": { "phpunit/phpunit": "^11.0 || ^12.0" },
    "autoload": { "psr-4": { "Hl\\AssetBundle\\": "src/" } },
    "autoload-dev": { "psr-4": { "Hl\\AssetBundle\\Tests\\": "tests/" } }
}
